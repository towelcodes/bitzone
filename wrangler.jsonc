{
	"name": "bitzone",
	"compatibility_date": "2025-10-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"r2_buckets": [
		{
			"binding": "bucket",
			"bucket_name": "bitzone",
		},
	],
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "bitzone",
			"database_id": "4d66bdf5-9928-45d0-85c8-2f2d9fae58b6",
			"remote": true
		},
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
		},
	},
	"vars": {
		"PUBLIC_MAX_SIZE": "1000000000",
		"PUBLIC_BASE_URL": "https://files.towel.codes"
	},
}
